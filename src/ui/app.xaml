                                    <Button x:Name="btnNetQuickDiag" Style="{StaticResource PrimaryButtonStyle}" Content="[1] Diagnóstico Rápido Integrado" Width="230"/>
                                    <Button x:Name="btnNetDetailed" Content="[2] Teste Detalhado (Ping + HTTPS + DNS)" Width="260"/>
                                    <Button x:Name="btnNetSpeedtest" Content="[3] Teste Velocidade Download (Mbps)" Width="245"/>
                                    <Button x:Name="btnNetWifi" Content="[4] Diagnóstico Wi-Fi (Sinal/Redes)" Width="225"/>
                                    <Button x:Name="btnNetWifiReport" Content="[4b] Gerar Relatório Wi-Fi (HTML)" Width="225"/>
                                    <Button x:Name="btnNetTestPort" Content="[5] Testar Porta TCP Alvo" Width="185"/>
                                    <Button x:Name="btnNetPathping" Content="[6] Perda de Pacotes (Pathping)" Width="215"/>
                                    <Button x:Name="btnNetTracert" Content="[7] Rastrear Rota (Tracert)" Width="195"/>
                                    <Button x:Name="btnNetPingCont" Content="[8] Ping Contínuo (-t)" Width="175"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Monitoramento, Varredura &amp; Dispositivos Locais (Opções 9 a 11)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,8"/>
